{
  "name": "wind",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "decode-uri-component": "file:./vendor/decode-uri-component",
    "deepmerge": "file:./vendor/deepmerge",
    "expo": "~57.0.31",
    "expo-auth-session": "~57.0.16",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.22",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "pg": "8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "maplibre-gl": "^6.12.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test:scenarios": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check-scenarios.mjs",
    "test:access": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check-terminal-access.mjs",
    "test:jobs-ui": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check-jobs-pages.mjs",
    "test:location": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check-customer-location.mjs",
    "test:android-browser": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check-android-browser.mjs",
    "test": "node scripts/run-tests.mjs",
    "lint": "expo lint",
    "server": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning server/main.ts",
    "screens": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/screens.mjs",
    "promote": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning server/main.ts promote",
    "test:readiness": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check-readiness.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "test:load": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check-load.mjs",
    "phone:server": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/phone-test-server.mjs",
    "phone:web": "node scripts/export-phone-web.mjs",
    "phone:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check-phone-tests.mjs smoke",
    "test:dependency-security": "node tests/dependency-security.test.mjs",
    "test:contracts": "node scripts/check-contracts.mjs",
    "test:persistence": "node scripts/check-persistence.mjs",
    "db:migrate:staging": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/migrate-postgres.mjs"
  },
  "zroScripts": {
    "install": "npm install -g @moonmath-ai/zro || true",
    "login": "zro login --api-key $ZRO_API_KEY",
    "launch:opencode": "zro launch opencode --model deepseek-v4.1-flash"
  },
  "private": true,
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "xcode": {
      "uuid": "11.1.1"
    },
    "node-forge": "file:./vendor/node-forge",
    "zod": "4.6.7",
    "deepmerge": "$deepmerge"
  }
}
