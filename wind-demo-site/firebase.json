{
  "hosting": {
    "public": "public",
    "site": "wind-demo-qa",
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/_expo/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ],
        "source": "/demo-mock.js"
      },
      {
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ],
        "source": "**/*.html"
      },
      {
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ],
        "source": "/"
      }
    ]
  }
}
