# /etc/cron.d/wind on the VM (root:root 0644). The backup uploads with curl and a managed-identity token (/srv/azure-token.sh).
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
10 3 * * * root /srv/wind-backup.sh >> /var/log/wind-backup.log 2>&1
* * * * * root /srv/wind-watchdog.sh
