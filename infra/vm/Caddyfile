# /srv/Caddyfile on the VM. WIND_ORIGIN is the VM's public name (windapp-ps.swedencentral.cloudapp.azure.com): Caddy holds a
# Let's Encrypt certificate for it and is the only thing listening on 80 and 443. Port 80 answers certificate checks and redirects.
{$WIND_ORIGIN} {
	reverse_proxy wind-api:4000 {
		# Callers reach Caddy directly and no trusted_proxies are set, so Caddy does not trust a caller's X-Forwarded-For; the last
		# entry it sends is always the TCP peer, which is what the API keys its per-address limits on (server/domain/client-address.ts).
		# The API listens on 127.0.0.1:4000 only (deploy.sh) and the NSG admits 80/443, so nothing reaches it except through Caddy.
		transport http {
			keepalive 4s # below Node's 5 s keepAliveTimeout, so Caddy never reuses a socket the API just closed
		}
	}
}
