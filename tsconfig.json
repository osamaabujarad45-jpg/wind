{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": ["expo/types"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", ".artifacts", "android", "ios", "server",
    ".claude", ".commandcode", "research", "research_notes", "session-bridge",
    "project-media", "reports", "dist"]
}
