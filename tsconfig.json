{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": ["expo/types"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", ".artifacts", "android", "ios", "server", "research_notes", ".expo", ".scratch", "dist", "vendor"]
}
