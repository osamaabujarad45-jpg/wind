# Public values are compiled into the app. Never put API or partner secrets here.
# Copy to .env.local for development, or configure the EAS production environment.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPPORT_WHATSAPP=
EXPO_PUBLIC_SUPPORT_CONTACT=

# Local production exports/builds: set WIND_RELEASE=1 and a real public HTTPS API.
# WIND_RELEASE=1
# Local USB debug exports only: WIND_LOCAL_TEST=1 (never a release task).
# WIND_LOCAL_TEST=1

# Local Android release upload key. EAS may manage credentials instead.
WIND_KEYSTORE=
WIND_STORE_PASSWORD=
WIND_KEY_ALIAS=
WIND_KEY_PASSWORD=

# Azure Entra External ID (optional; password auth stays on while unset).
# Tenant ID is the directory GUID; tenant name is the ciamlogin.com subdomain.
# EXPO_PUBLIC_ENTRA_TENANT_NAME=
# EXPO_PUBLIC_ENTRA_TENANT_ID=
# EXPO_PUBLIC_ENTRA_CLIENT_ID=
# WIND_ENTRA_TENANT_NAME=
# WIND_ENTRA_TENANT_ID=
# WIND_ENTRA_CLIENT_ID=

# Forced upgrade: API answers 426 to app builds below this (app.json 1.0.14 -> 10014).
# Installs up to 1.0.13 send no build header and are never gated. Unset = off.
# WIND_MIN_CLIENT_BUILD=

# Operator-only CLI jobs are disabled by default. Install and pin the CLI yourself;
# the API never downloads executables. Production refuses CLI jobs even when
# enabled, until an isolated job runner can protect API files and credentials.
# WIND_OPENCODE_ENABLED=0
# ZRO_CLI_PATH=

# Server. Production refuses to start without the first four; README lists every setting.
# SUPPORT_CONTACT=
# WIND_IDENTITY_MODE=self-service
# WIND_TRUST_PROXY=1
# WIND_PUSH_SUBJECT=https://your-public-api-domain
# Native push, once Firebase is set up as in docs/operations/deploy.md. The EAS file variable holds google-services.json.
# WIND_EXPO_PUSH_ENABLED=1
# EXPO_ACCESS_TOKEN=
# GOOGLE_SERVICES_JSON=
