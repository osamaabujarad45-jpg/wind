{
  "expo": {
    "name": "Wind",
    "slug": "wind",
    "scheme": "wind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ps.wind.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ps.wind.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8F7F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wind uses your location to help set your pickup point."
        }
      ],
      "expo-font",
      [
        "expo-localization",
        {
          "supportsRTL": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F8F7F0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
